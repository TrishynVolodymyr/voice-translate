# Copy this file to .env and change what you need. .env stays on your PC (it is not committed).
# Relative paths are relative to this folder. Empty = default.

# Folders
VT_MODELS_DIR=models
# your voice samples (ref_uk.wav, designed voices) and prompts.json
VT_VOICES_DIR=voices
VT_LOGS_DIR=logs

# Voice sample used by default (file name in VT_VOICES_DIR without .wav)
VT_REF=ref_uk

# Devices: part of the name or the number (Record-Samples.bat --list). Empty = Windows default.
VT_MIC=
VT_OUT=

# Push-to-talk key (and the «be quiet» key in simultaneous mode), pynput names: ctrl_r, alt_r, f9, x …
VT_PUSH_KEY=ctrl_r

# Port of the local llama.cpp server for the Hy-MT2-7B translator (listens on 127.0.0.1 only)
VT_LLAMA_PORT=8093
