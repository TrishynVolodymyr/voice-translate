# Copy this file to .env and change what you need. .env stays on your PC (it is not committed).
# Relative paths are relative to this folder. Empty = default.

# Folders
VT_MODELS_DIR=models
# your voice samples (ref_uk.wav, designed voices) and prompts.json
VT_VOICES_DIR=voices
VT_LOGS_DIR=logs

# Languages, ISO 639-1 codes: you speak VT_SOURCE_LANG, the voice speaks VT_TARGET_LANG (see README, «Languages»).
#   you speak (Parakeet):  bg cs da de el en es et fi fr hr hu it lt lv mt nl pl pt ro ru sk sl sv uk
#   the voice (Qwen3-TTS): en zh ja ko de fr ru pt es it
#   translator: Hy-MT2 for cs de en es fr it nl pl pt ru uk; quickmt only to/from English (run Download-Models.bat
#   again after changing the pair — it fetches the quickmt model for it, if there is one)
VT_SOURCE_LANG=uk
VT_TARGET_LANG=en

# Translator for every launcher (README, «Translator»). Empty = each launcher's own (Hy-MT2-7B / quickmt).
#   quickmt | hymt7 | hymt1.8 | path to any GGUF, e.g. models\my-finetune.gguf (served by llama-server, Hy-MT2 prompt)
VT_MT=
# Layers of a GGUF translator on the GPU: empty = all, except game mode (CPU, to leave the VRAM to the game);
# 999 = all on the GPU everywhere, 0 = CPU everywhere, a number = split
VT_MT_NGL=

# Where recognition (and quickmt) runs: empty = push-to-talk on the CPU (more accurate Parakeet Ultra, ~0.15 s slower),
# the simultaneous mode on the GPU; cuda = always on the GPU (~3.5 GB more VRAM); cpu = always on the CPU
VT_ASR_DEVICE=

# Voice sample used by default (file name in VT_VOICES_DIR without .wav). Empty = ref_<VT_SOURCE_LANG>, e.g. ref_uk —
# the one Record-Samples.bat records
VT_REF=

# Devices: part of the name or the number (Record-Samples.bat --list). Empty = Windows default.
VT_MIC=
VT_OUT=

# Push-to-talk key (and the «be quiet» key in simultaneous mode), pynput names: ctrl_r, alt_r, f9, x …
VT_PUSH_KEY=ctrl_r

# Port of the local llama.cpp server for the Hy-MT2-7B translator (listens on 127.0.0.1 only)
VT_LLAMA_PORT=8093
