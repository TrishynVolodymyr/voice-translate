# Whitelist: everything is ignored unless listed below. Voice samples, recordings, logs, models, the environment,
# local settings and personal notes never get into git — add a file here only on purpose.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/LICENSE
!/README.md
!/README.uk.md
!/ROADMAP.md
!/ROADMAP.uk.md
!/THIRD_PARTY.md
!/requirements.txt
!/requirements.lock.txt
!/Install.bat
!/Download-Models.bat
!/Record-Samples.bat
!/Design-Voice.bat
!/Setup-VirtualCable.bat
!/Start-VoiceTranslate.bat
!/Start-VoiceTranslate-QuickMT.bat
!/Start-VoiceTranslate-Cable.bat
!/Start-StreamVoice.bat
!/Start-StreamTest.bat
!/Start-StreamTest-CPU.bat

!/scripts/
/scripts/*
!/scripts/pipeline.py
!/scripts/stream_core.py
!/scripts/voice_translate.py
!/scripts/stream_test.py
!/scripts/record_samples.py
!/scripts/design_voice.py
!/scripts/bench_asr.py
!/scripts/verify_sha.py
!/scripts/Install.ps1
!/scripts/Download-Models.ps1
!/scripts/Start-VoiceTranslate.ps1
!/scripts/AudioDefault.ps1
!/scripts/Setup-VirtualCable.ps1
